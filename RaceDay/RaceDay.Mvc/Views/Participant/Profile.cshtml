<!-- We use a custom ViewModel here to handle the file upload -->
@model RaceDay.Mvc.ViewModels.ProfileVm

@{
    ViewData["Title"] = "My Profile";
}

<h2>My Profile</h2>

<form asp-action="Profile" method="post" enctype="multipart/form-data">
    
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Display current profile picture if one exists -->
    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
    {
        <div class="mb-3">
            <img src="@Model.ProfileImageUrl" alt="Profile Picture" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover;" />
        </div>
    }

    <div class="mb-3">
        <label class="form-label">Update Profile Picture</label>
        <input type="file" name="profileFile" class="form-control" accept="image/*" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>