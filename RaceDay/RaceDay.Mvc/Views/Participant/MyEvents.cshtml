@model List<RaceDay.Contracts.EnrolmentDto>
@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">
    <h2>My Registered Events</h2>
    <p class="text-muted">Here are all the events you have entered.</p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">You haven't entered any events yet. <a asp-action="Index">Browse events here</a>.</div>
    }
    else
    {
        <table class="table table-striped shadow-sm mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Date Enrolled</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EventName</td>
                        <td>@item.CategoryName</td>
                        <td>@item.EnrolmentDate.ToShortDateString()</td>
                        <td>
                            @if(item.Status == "Confirmed") { <span class="badge bg-success">Confirmed</span> }
                            else if(item.Status == "Pending") { <span class="badge bg-warning text-dark">Pending</span> }
                            else { <span class="badge bg-secondary">@item.Status</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>