@model RaceDay.Contracts.CreateEventRequest

@{
    ViewData["Title"] = "Create Event";
}

<h2>Create New Event</h2>

<!-- Notice the enctype="multipart/form-data" - THIS IS REQUIRED FOR FILE UPLOADS -->
<form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
    
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Event Name</label>
        <input asp-for="Name" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="EventDate" class="form-label">Date</label>
            <input asp-for="EventDate" type="date" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Location" class="form-label">Location</label>
            <input asp-for="Location" class="form-control" required />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
            <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EventType" class="form-label">Event Type</label>
            <select asp-for="EventType" class="form-select">
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>
    </div>

    <!-- THIS IS THE FILE INPUT FOR THE BANNER -->
    <div class="mb-3">
        <label class="form-label">Event Banner Image</label>
        <input type="file" name="bannerFile" class="form-control" accept="image/*" />
        <small class="text-muted">Upload a JPEG or PNG for the event banner.</small>
    </div>

    <button type="submit" class="btn btn-primary">Create Event</button>
    <a asp-action="Events" class="btn btn-secondary">Cancel</a>
</form>