@model List<RaceDay.Contracts.EventDto>
@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage My Events</h2>
        <a asp-action="CreateEvent" class="btn btn-success">Create New Event</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            You have not created any events yet. Click "Create New Event" to get started.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var ev in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-dark text-white d-flex justify-content-between">
                            <span>@ev.Name</span>
                            <span class="badge bg-info text-dark">@ev.EventType</span>
                        </div>
                        
                        <!-- Show the banner image if it exists -->
                        @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                        {
                            <img src="@ev.BannerImageUrl" class="card-img-top" alt="@ev.Name" style="height: 150px; object-fit: cover;">
                        }
                        
                        <div class="card-body">
                            <p class="mb-1"><strong>Date:</strong> @ev.EventDate.ToShortDateString()</p>
                            <p class="mb-1"><strong>Location:</strong> @ev.Location</p>
                            <p class="mb-1"><strong>Distance:</strong> @ev.DistanceKm km</p>
                            <p class="text-muted small mt-2">@ev.Description</p>
                        </div>
                        <div class="card-footer bg-white">
                            <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Categories" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-success">Categories</a>
                            <a asp-action="Enrolments" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-info">Enrolments & Results</a>
                            
                            <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>