@model List<RaceDay.Contracts.EventDto>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Organiser Dashboard</h2>
        <a asp-action="CreateEvent" class="btn btn-primary">Create New Event</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">My Events</h5>
            @if (Model.Count == 0)
            {
                <p class="text-muted">You haven't created any events yet.</p>
            }
            else
            {
                <table class="table table-hover mt-3">
                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td>@ev.Name</td>
                                <td>@ev.EventDate.ToShortDateString()</td>
                                <td>@ev.Location</td>
                                <td><span class="badge bg-info text-dark">@ev.EventType</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>