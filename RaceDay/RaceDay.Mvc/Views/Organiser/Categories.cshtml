@model List<RaceDay.Contracts.CategoryDto>
@{ ViewData["Title"] = "Manage Categories"; int eventId = ViewBag.EventId; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Categories</h2>
        <a asp-action="Events" class="btn btn-secondary">Back to Events</a>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white">Add New Category</div>
                <div class="card-body">
                    <form asp-action="AddCategory" method="post">
                        <input type="hidden" name="eventId" value="@eventId" />
                        <div class="mb-2">
                            <label class="form-label">Category Name</label>
                            <input type="text" name="Name" class="form-control" required placeholder="e.g. 10km Open" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Description</label>
                            <input type="text" name="Description" class="form-control" />
                        </div>
                        <div class="row">
                            <div class="col-6 mb-2">
                                <label class="form-label">Entry Fee (R)</label>
                                <input type="number" step="0.01" name="EntryFee" class="form-control" required />
                            </div>
                            <div class="col-6 mb-2">
                                <label class="form-label">Max Participants</label>
                                <input type="number" name="MaxParticipants" class="form-control" required />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success w-100 mt-2">Add Category</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <table class="table table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Category Name</th>
                        <th>Fee</th>
                        <th>Max Capacity</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-muted">No categories yet.</td></tr>
                    }
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td>@cat.Name</td>
                            <td>R @cat.EntryFee</td>
                            <td>@cat.MaxParticipants</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>